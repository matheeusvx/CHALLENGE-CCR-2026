API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_OUTPUT_ROOT=outputs/satellite_monitoring
ANALYSIS_TIMEZONE=America/Sao_Paulo
MULTISOURCE_ENABLED=false
SENTINEL1_ENABLED=false
SENTINEL1_COLLECTION=sentinel-1-grd
SENTINEL1_MAX_SCENES=8
SENTINEL1_TEMPORAL_ENABLED=false
SENTINEL1_TEMPORAL_MIN_OBSERVATIONS=4
SENTINEL1_TEMPORAL_MIN_SPAN_DAYS=18
SENTINEL1_TEMPORAL_MIN_TOTAL_CHANGE_DB=1.0
SENTINEL1_TEMPORAL_RESIDUAL_MAD_MULTIPLIER=2.0
SENTINEL1_TEMPORAL_MAX_GAP_DAYS=24
GEDI_ENABLED=false
ICESAT2_ENABLED=false
HEIGHT_ESTIMATION_ENABLED=false
SPATIAL_SEGMENTATION_ENABLED=false
SPATIAL_SECTION_LENGTH_M=50
SPATIAL_REGULARIZATION_ENABLED=false
MULTISOURCE_FUSION_MODE=disabled
# Experimental multisource recommendation:
# MULTISOURCE_ENABLED=true
# SENTINEL1_ENABLED=true
# SENTINEL1_TEMPORAL_ENABLED=true
# MULTISOURCE_FUSION_MODE=experimental
# Operational also requires those flags and a scientifically valid independent holdout artifact.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Persistent experimental ground-truth samples (relative paths use the repository root)
VALIDATION_DB_PATH=data/validation/validation.sqlite3
# Frozen offline artifact served by GET /api/validation-multisensor-benchmark-v2
VALIDATION_MULTISENSOR_BENCHMARK_V2_PATH=outputs/validation/validation_multisensor_benchmark_v2.json
# Frozen independent holdout artifact; GET never recalculates it
VALIDATION_HOLDOUT_BENCHMARK_PATH=outputs/validation-holdout/validation_holdout_benchmark_v1.json
