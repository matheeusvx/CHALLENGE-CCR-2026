{
  "openapi": "3.1.0",
  "info": {
    "title": "Motiva Vegetation Intelligence API",
    "description": "API sincrona para validacao de AOI e monitoramento Sentinel-2.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthcheck",
        "operationId": "healthcheck_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/validate-geometry": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Validate Geometry",
        "operationId": "validate_geometry_api_analyses_validate_geometry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeometryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeometryValidationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/run": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Run Analysis",
        "operationId": "run_analysis_api_analyses_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{analysis_id}/artifacts/{artifact_name}": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "Get Artifact",
        "operationId": "get_artifact_api_analyses__analysis_id__artifacts__artifact_name__get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Analysis Id"
            }
          },
          {
            "name": "artifact_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisPeriodResponse": {
        "properties": {
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "previous_calendar_month",
              "explicit"
            ],
            "title": "Strategy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "timezone",
          "strategy"
        ],
        "title": "AnalysisPeriodResponse"
      },
      "AnalysisResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "recommendation": {
            "$ref": "#/components/schemas/RecommendationResponse"
          },
          "height_estimation": {
            "$ref": "#/components/schemas/HeightEstimationResponse"
          },
          "analysis_period": {
            "$ref": "#/components/schemas/AnalysisPeriodResponse"
          },
          "selected_area_m2": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Area M2"
          },
          "effective_analysis_area_m2": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Analysis Area M2"
          },
          "effective_analysis_pct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Analysis Pct"
          },
          "aoi": {
            "additionalProperties": true,
            "type": "object",
            "title": "Aoi"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "timeseries": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Timeseries"
          },
          "scenes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Scenes"
          },
          "artifacts": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Artifacts"
          },
          "warnings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Warnings"
          },
          "errors": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_id",
          "status",
          "recommendation",
          "height_estimation",
          "analysis_period",
          "aoi",
          "summary",
          "timeseries",
          "scenes",
          "artifacts",
          "warnings",
          "errors"
        ],
        "title": "AnalysisResponse"
      },
      "AnalysisRunRequest": {
        "properties": {
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "max_cloud_cover": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Cloud Cover"
          },
          "max_scenes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Scenes"
          },
          "scene_order": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "newest",
                  "oldest"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Order"
          },
          "min_valid_pixel_percentage": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Valid Pixel Percentage"
          },
          "min_observations": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Observations"
          },
          "daily_aggregation": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "best",
                  "median",
                  "none"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Aggregation"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionParameters"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "geometry"
        ],
        "title": "AnalysisRunRequest"
      },
      "Centroid": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "Centroid"
      },
      "DecisionParameters": {
        "properties": {
          "decision_min_observations": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Min Observations"
          },
          "high_vegetation_percentile": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "High Vegetation Percentile"
          },
          "significant_drop_absolute": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 2.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Significant Drop Absolute"
          },
          "significant_drop_relative_percentage": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Significant Drop Relative Percentage"
          },
          "trend_window": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Trend Window"
          },
          "max_gap_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 366.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Gap Days"
          },
          "recent_intervention_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 366.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Recent Intervention Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DecisionParameters"
      },
      "GeometryRequest": {
        "properties": {
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "geometry"
        ],
        "title": "GeometryRequest"
      },
      "GeometryValidationResponse": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "geometry_type": {
            "type": "string",
            "title": "Geometry Type"
          },
          "area_square_meters": {
            "type": "number",
            "title": "Area Square Meters"
          },
          "centroid": {
            "$ref": "#/components/schemas/Centroid"
          },
          "bounding_box": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bounding Box"
          },
          "estimated_sentinel_pixels": {
            "type": "integer",
            "title": "Estimated Sentinel Pixels"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "valid",
          "geometry_type",
          "area_square_meters",
          "centroid",
          "bounding_box",
          "estimated_sentinel_pixels",
          "warnings"
        ],
        "title": "GeometryValidationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse"
      },
      "HeightEstimationResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "experimental",
              "unavailable",
              "disabled"
            ],
            "title": "Status"
          },
          "estimated_class": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "le_30_cm",
                  "gt_30_cm",
                  "inconclusive"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Class"
          },
          "score_gt_30_cm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Gt 30 Cm"
          },
          "probability_gt_30_cm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Probability Gt 30 Cm",
            "description": "Deprecated alias of score_gt_30_cm; not calibrated probability.",
            "deprecated": true
          },
          "calibration_status": {
            "anyOf": [
              {
                "type": "string",
                "const": "uncalibrated"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibration Status"
          },
          "vegetation_fraction": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Vegetation Fraction"
          },
          "height_valid_pixel_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Valid Pixel Count"
          },
          "height_total_pixel_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Total Pixel Count"
          },
          "mixed_pixel_risk": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mixed Pixel Risk"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "reference_threshold_cm": {
            "type": "integer",
            "const": 30,
            "title": "Reference Threshold Cm",
            "default": 30
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "provenance": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "estimated_class",
          "confidence",
          "model_version"
        ],
        "title": "HeightEstimationResponse"
      },
      "RecommendationResponse": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "cortar",
              "nao_cortar",
              "inconclusivo"
            ],
            "title": "Decision"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "experimental": {
            "type": "boolean",
            "title": "Experimental"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "blocking_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blocking Reasons"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "metrics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metrics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "confidence",
          "experimental",
          "summary",
          "reasons",
          "blocking_reasons",
          "limitations"
        ],
        "title": "RecommendationResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
